Bootstrap: docker
From: cgr.dev/chainguard/wolfi-base:latest

%files
    # Build from the repository root.
    envs/environment.yml /opt/naam/environment.yml
    scripts/amplicon_project.py /amplicon_project.py
    workflow/snakefile_naam.smk /snakefile_naam.smk
    scripts/viz_nextclade_cli.R /viz_nextclade_cli.R
    config/virus_config.yaml /virus_config.yaml
    NAAM_VERSION /NAAM_VERSION

%post
    set -eu

    # This definition targets linux-64 Conda packages.
    if [ "$(uname -m)" != "x86_64" ]; then
        echo "This definition requires an x86_64 build host." >&2
        exit 1
    fi

    # Runtime utilities.
    apk add --no-cache bash ca-certificates coreutils

    # Utilities needed only during the build.
    apk add --no-cache --virtual .naam-build-deps \
        curl gnutar bzip2 findutils

    TARGET_ENV_PATH="/opt/conda/envs/naam"
    export MAMBA_ROOT_PREFIX="/opt/naam-mamba-build"

    mkdir -p /opt/naam-build

    curl --fail --location --retry 3 \
        https://micro.mamba.pm/api/micromamba/linux-64/latest \
        --output /opt/naam-build/micromamba.tar.bz2

    tar -xjf /opt/naam-build/micromamba.tar.bz2 \
        -C /opt/naam-build bin/micromamba

    /opt/naam-build/bin/micromamba --no-rc create \
        --yes \
        --strict-channel-priority \
        --prefix "${TARGET_ENV_PATH}" \
        --file /opt/naam/environment.yml

    # Record the exact resolved packages.
    /opt/naam-build/bin/micromamba --no-rc list \
        --prefix "${TARGET_ENV_PATH}" \
        --explicit > /opt/naam/conda-linux-64.explicit.txt

    # Remove package downloads and solver caches.
    /opt/naam-build/bin/micromamba --no-rc clean --all --yes

    # Conservative cleanup, retaining libraries and Python bytecode.
    rm -rf \
        "${TARGET_ENV_PATH}/share/doc" \
        "${TARGET_ENV_PATH}/share/man" \
        "${TARGET_ENV_PATH}/lib/R/doc" \
        /opt/naam-build \
        "${MAMBA_ROOT_PREFIX}"

    apk del .naam-build-deps

%environment
    export PATH="/opt/conda/envs/naam/bin:${PATH}"
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONNOUSERSITE=1
    export R_LIBS_USER=""
    export SSL_CERT_FILE="/etc/ssl/certs/ca-certificates.crt"

%runscript
    #!/bin/sh
    set -eu

    if [ "${1:-}" = "--version" ]; then
        cat /NAAM_VERSION
        exit 0
    fi

    container="${APPTAINER_CONTAINER:-${SINGULARITY_CONTAINER:-naam.sif}}"
    container="$(basename "$container")"

    echo "NAAM Workflow Container - Version: $(cat /NAAM_VERSION)"
    echo "----------------------------------------------------"
    echo "This container provides a two-step amplicon analysis workflow."
    echo
    echo "Usage:"
    echo "  singularity run \"$container\" --version"
    echo
    echo "Workflow Steps:"
    echo "  1. Prepare project directory:"
    echo "     singularity exec \"$container\" python /amplicon_project.py -p <project_dir> ..."
    echo
    echo "  2. Run the Snakemake workflow:"
    echo "     singularity exec \"$container\" snakemake --snakefile <project_dir>/Snakefile --cores <N>"
    echo

%test
    set -eu

    export PATH="/opt/conda/envs/naam/bin:${PATH}"
    export PYTHONNOUSERSITE=1
    export R_LIBS_USER=""

    python --version
    snakemake --version
    ampliclip --version
    virconsens -h
    Rscript --vanilla -e 'cat(R.version.string, "\n")'

    test -s /NAAM_VERSION
    test -f /amplicon_project.py
    test -f /snakefile_naam.smk
    test -f /viz_nextclade_cli.R
    test -f /virus_config.yaml

    echo "NAAM installation smoke tests passed."